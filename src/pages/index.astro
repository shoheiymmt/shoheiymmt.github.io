---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).sort(
  (first, second) => second.data.date.valueOf() - first.data.date.valueOf(),
);
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="shoheiymmt">
  <h1>記事一覧</h1>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`${baseUrl}/posts/${post.id}/`}>{post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('ja-JP')}
        </time>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  h1 {
    margin: 3.5rem 0 1.5rem;
    font-size: 1.6rem;
  }

  .post-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #d9d7d0;
  }

  .post-list a {
    font-size: 1.1rem;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  time {
    flex: 0 0 auto;
    color: #696762;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    h1 {
      margin-top: 2.5rem;
    }

    .post-list li {
      display: block;
    }

    time {
      display: block;
      margin-top: 0.25rem;
    }
  }
</style>