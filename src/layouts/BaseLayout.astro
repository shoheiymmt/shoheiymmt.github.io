---
const { title = 'shoheiymmt', description = 'shoheiymmtの技術ブログです。' } = Astro.props;
const homeUrl = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="site-title" href={homeUrl}>shoheiymmt</a>
        <a
          class="github-link"
          href="https://github.com/shoheiymmt/blog"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub リポジトリ"
          title="GitHub リポジトリ"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.08 1.83 1.23 1.83 1.23 1.07 1.83 2.8 1.3 3.48.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.17 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.87.12 3.17.77.84 1.23 1.91 1.23 3.22 0 4.6-2.8 5.63-5.48 5.93.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.58A12 12 0 0 0 12 .5Z" />
          </svg>
        </a>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color: #202124;
    background: #f8f7f3;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 18px;
    line-height: 1.8;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }

  .container {
    width: min(100% - 2rem, 42rem);
    margin-inline: auto;
  }

  .site-header {
    padding: 2rem 0;
    border-bottom: 1px solid #d9d7d0;
  }

  .site-header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-title {
    color: #202124;
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
  }

  .github-link {
    display: inline-flex;
    color: #202124;
    line-height: 0;
  }

  .github-link svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
  }

  a {
    color: #8b3a32;
  }

  @media (max-width: 40rem) {
    :root {
      font-size: 16px;
    }

    .site-header {
      padding: 1.25rem 0;
    }
  }
</style>